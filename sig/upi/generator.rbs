module Upi
  class Generator
    include Validations
    include Rendering

    type amount = Numeric | String | nil
    type fields = Hash[Symbol, String?]

    CURRENCY: String
    MODE_DEFAULT: String
    MODE_QR: String
    MODE_SECURE_QR: String
    MODE_INTENT: String
    MODE_SECURE_INTENT: String
    MODE_NFC: String
    MODE_BLE: String
    MODE_UHF: String
    MODE_SEBI: String
    SECURE_MODES: Array[String]
    PARAM_ORDER: Array[Symbol]
    SIGNATURE_TAG: Symbol

    @upi_id: String
    @name: String
    @currency: String
    @merchant_code: String?
    @org_id: String?
    @no_url_parse: bool
    @params: Hash[Symbol, String]

    attr_reader params: Hash[Symbol, String]
    attr_reader no_url_parse: bool
    attr_reader signer: Signer?

    def self.generate_reference: (?String prefix) -> String

    def initialize: (
      upi_id: String,
      name: String,
      ?currency: String,
      ?merchant_code: String?,
      ?org_id: String?,
      ?signer: Signer?,
      ?no_url_parse: bool
    ) -> void

    def upi_content: (
      ?amount amount,
      ?String? note,
      ?transaction_ref_id: String?,
      ?transaction_id: String?,
      ?url: String?,
      ?min_amount: amount,
      ?initiation_mode: String?
    ) -> String

    def generate_qr: (
      ?amount amount,
      ?String? note,
      ?transaction_ref_id: String?,
      ?transaction_id: String?,
      ?url: String?,
      ?min_amount: amount,
      ?initiation_mode: String?,
      ?mode: Symbol,
      ?level: Symbol,
      **untyped render_options
    ) -> String

    private

    def serialize: (fields) -> String
    def build_fields: (amount, String?, String?, String?, String?, amount, String?) -> fields
    def require_reference!: (String?, String?) -> void
    def normalize_min_amount: (amount, String?) -> String?
    def encode: (untyped, ?lenient: bool) -> String
  end
end
